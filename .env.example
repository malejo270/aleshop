# Neon / PostgreSQL
# Preferred: copy the pooled Neon connection string here.
DATABASE_URL=

# Better Auth
# Generate a long random value for production.
BETTER_AUTH_SECRET=
# Optional. On Vercel the app can infer the production URL automatically.
BETTER_AUTH_URL=

# Admin restriction: only this email can access /admin.
ADMIN_EMAIL=

# Vercel Blob (only required for uploading product images from the admin panel)
BLOB_READ_WRITE_TOKEN=
